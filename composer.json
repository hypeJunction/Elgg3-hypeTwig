{
    "name": "hypejunction/hypetwig",
    "type": "elgg-plugin",
    "description": "Twig template integration",
    "homepage": "https://github.com/hypeJunction/elgg-twig",
    "keywords": [
        "elgg",
        "plugin",
        "twig",
        "templates"
    ],
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Ismayil Khayredinov",
            "email": "ismayil.khayredinov@gmail.com"
        }
    ],
    "extra": {
        "installer-name": "hypeTwig",
        "elgg-plugin": {
            "id": "hypetwig"
        }
    },
    "require": {
        "php": ">=8.1",
        "composer/installers": "^2.0",
        "elgg/elgg": "^4.0",
        "twig/twig": "^3.0"
    },
    "autoload": {
        "psr-0": {
            "": "classes/"
        },
        "files": [
            "lib/functions.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        },
        "audit": {
            "block-insecure": false
        }
    }
}
